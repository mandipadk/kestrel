[Unit]
Description=Kestrel weekly security review
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=kestrel
WorkingDirectory=/home/ubuntu/code/kestrel
Environment=PATH=/home/ubuntu/.cargo/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/code/kestrel/kestrel/security-review.sh
TimeoutStartSec=4h
Nice=10
